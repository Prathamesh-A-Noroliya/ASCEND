{
  "installCommand": "npm install --prefix frontend --legacy-peer-deps",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ascend-backend-rosy.vercel.app/api/:path*"
    }
  ]
}
